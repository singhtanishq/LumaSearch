{
  "name": "luma-search",
  "version": "0.1.0",
  "private": true,
  "description": "LumaSearch — A production-grade, open-source, self-hostable, next-generation search engine. Fully self-contained: Node.js + SQLite, no Docker required.",
  "scripts": {
    "setup": "pnpm install && pnpm run db:generate && pnpm run build",
    "dev": "pnpm --filter @luma-search/server dev",
    "start": "pnpm --filter @luma-search/server start",
    "seed": "pnpm --filter @luma-search/server seed",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "db:generate": "pnpm --filter @luma-search/storage db:generate",
    "db:push": "pnpm --filter @luma-search/storage db:push",
    "db:studio": "pnpm --filter @luma-search/storage db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo data"
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "playwright": "^1.64.1",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.6"
}
