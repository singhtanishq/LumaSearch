FROM luma-base AS api
WORKDIR /workspace/apps/api
# Copy Prisma client from base image
COPY --from=luma-base /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0 /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0
COPY --from=luma-base /workspace/.prisma-app /workspace/node_modules/.prisma
# Ensure the client directory is properly linked
RUN mkdir -p /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma && \
    cp -r /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma/client /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma/client
EXPOSE 4000
CMD ["pnpm", "start"]