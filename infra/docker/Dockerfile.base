# Shared base image with dependencies and packages built.
# Build from repo root: docker build -f infra/docker/Dockerfile.base -t luma-base .
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /workspace

# Full copy (see .dockerignore); install then build all workspace packages.
COPY . .
RUN (pnpm install --frozen-lockfile || pnpm install) \
    && pnpm --filter './packages/**' build