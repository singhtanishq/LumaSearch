# =============================================================================
# LumaSearch Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# All variables with defaults are optional

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=LumaSearch
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:4001

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://luma:luma@localhost:5432/luma_search?schema=public

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Redis (Queue, Cache, Sessions)
# -----------------------------------------------------------------------------
# Format: redis://:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis cluster (optional, for production)
# REDIS_CLUSTER_NODES=host1:port1,host2:port2,host3:port3

# -----------------------------------------------------------------------------
# Elasticsearch / OpenSearch
# -----------------------------------------------------------------------------
# Format: http://user:password@host:port
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT= # Path to CA cert for TLS
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_MAX_RETRIES=3

# Index settings
ES_INDEX_PREFIX=luma
ES_NUMBER_OF_SHARDS=1
ES_NUMBER_OF_REPLICAS=0
ES_REFRESH_INTERVAL=1s

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT secret for access tokens (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API key settings
API_KEY_PREFIX=luma_
API_KEY_HASH_ROUNDS=12

# Password hashing
BCRYPT_ROUNDS=12

# Session (for admin dashboard)
SESSION_SECRET=your-session-secret-change-in-production-min-32-chars
SESSION_COOKIE_NAME=luma_session
SESSION_COOKIE_SECURE=false # Set to true in production with HTTPS
SESSION_COOKIE_SAME_SITE=lax

# CSRF
CSRF_SECRET=your-csrf-secret-change-in-production

# -----------------------------------------------------------------------------
# Encryption (for sensitive data at rest)
# -----------------------------------------------------------------------------
# 32-byte base64 encoded key for AES-256-GCM
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email (Optional - for notifications, auth emails)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@luma-search.local
SMTP_TLS=true

# -----------------------------------------------------------------------------
# Crawler
# -----------------------------------------------------------------------------
CRAWLER_USER_AGENT=LumaSearch/0.1 (+https://github.com/luma-search/luma-search)
CRAWLER_MAX_CONCURRENT=10
CRAWLER_PER_DOMAIN_CONCURRENT=2
CRAWLER_POLITENESS_DELAY=1000
CRAWLER_REQUEST_TIMEOUT=30000
CRAWLER_MAX_REDIRECTS=10
CRAWLER_MAX_CONTENT_SIZE=10485760 # 10MB
CRAWLER_MAX_DECOMPRESSED_SIZE=52428800 # 50MB
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_CRAWL_DELAY_MS=1000
CRAWLER_ALLOWED_DOMAINS= # Comma-separated, empty = all
CRAWLER_BLOCKED_DOMAINS= # Comma-separated
CRAWLER_SEED_URLS= # Comma-separated seed URLs for demo

# Crawler safety
CRAWLER_BLOCK_PRIVATE_IPS=true
CRAWLER_DNS_REBINDING_PROTECTION=true
CRAWLER_MAX_URL_LENGTH=2048
CRAWLER_MAX_PARAMS=50

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Provider: local | openai | cohere | voyage
EMBEDDING_PROVIDER=local

# Local embeddings (Python service)
EMBEDDING_LOCAL_URL=http://localhost:8000
EMBEDDING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_BATCH_SIZE=32
EMBEDDING_LOCAL_DIMENSIONS=384

# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100

# Cohere embeddings
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIMENSIONS=1024

# Voyage embeddings
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3
VOYAGE_EMBEDDING_DIMENSIONS=1024

# Embedding cache
EMBEDDING_CACHE_TTL=86400 # 24 hours
EMBEDDING_CACHE_MAX_SIZE=100000

# -----------------------------------------------------------------------------
# LLM / AI Answers
# -----------------------------------------------------------------------------
# Provider: openai | anthropic | ollama | vertex | bedrock | disabled
LLM_PROVIDER=disabled

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.1

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vertex AI (Google Cloud)
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_CHAT_MODEL=gemini-1.5-flash

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Answer generation settings
ANSWER_MAX_EVIDENCE_PASSAGES=10
ANSWER_MAX_EVIDENCE_TOKENS=8000
ANSWER_TOKEN_BUDGET=2000
ANSWER_TIMEOUT_MS=30000
ANSWER_CACHE_TTL=3600 # 1 hour
ANSWER_ENABLE_RESEARCH_MODE=true
ANSWER_ENABLE_CITATIONS=true
ANSWER_PROMPT_INJECTION_DEFENSE=true

# -----------------------------------------------------------------------------
# Search & Ranking
# -----------------------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_RANKING_PROFILE=hybrid
SEARCH_ENABLE_HYBRID=true
SEARCH_HYBRID_RRF_K=60
SEARCH_HYBRID_RRF_WINDOW=100
SEARCH_ENABLE_QUERY_EXPANSION=true
SEARCH_ENABLE_SPELL_CORRECTION=true
SEARCH_HIGHLIGHT_FRAGMENT_SIZE=150
SEARCH_HIGHLIGHT_NUM_FRAGMENTS=3

# Ranking profiles weights (JSON)
# SEARCH_RANKING_PROFILES={"fastest":{"bm25":1,"vector":0},"recent":{"bm25":0.7,"vector":0.3,"freshness":2}}

# -----------------------------------------------------------------------------
# Queue (BullMQ)
# -----------------------------------------------------------------------------
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_MS=5000
QUEUE_BACKOFF_TYPE=exponential
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_WINDOW=60000

# Queue names
QUEUE_CRAWL_FETCH=crawl:fetch
QUEUE_CRAWL_PARSE=crawl:parse
QUEUE_INDEX_INGEST=index:ingest
QUEUE_EMBED_GENERATE=embed:generate
QUEUE_ANSWER_GENERATE=answer:generate
QUEUE_ANALYTICS_AGGREGATE=analytics:aggregate

# -----------------------------------------------------------------------------
# Telemetry & Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json # json | pretty
LOG_PRETTY_PRINT=false

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=luma-search
OTEL_SAMPLING_RATIO=0.1

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health checks
HEALTH_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_ANSWERS=false
FEATURE_RESEARCH_WORKSPACE=false
FEATURE_CRAWL_SCHEDULER=true
FEATURE_VERTICAL_SEARCH=false
FEATURE_ADMIN_DASHBOARD=true
FEATURE_MULTI_TENANCY=false
FEATURE_BILLING=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_CRAWL_MAX=10
RATE_LIMIT_AUTH_MAX=5

# -----------------------------------------------------------------------------
# Storage (S3-compatible for snapshots, backups)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=luma-search
S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# Demo / Development
# -----------------------------------------------------------------------------
SEED_DEMO_DATA=false
DEMO_CORPUS_URL=https://demo-data.luma-search.dev/corpus.json.gz
SKIP_EXTERNAL_SERVICES=false # Set true to run without ES/Redis/Postgres (limited functionality)