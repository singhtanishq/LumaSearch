# =============================================================================
# LumaSearch Environment Configuration (self-contained mode)
# =============================================================================
# Copy to .env and customize. Everything works out-of-the-box with defaults.

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=LumaSearch
API_PORT=4000
# Directory for SQLite databases and indexed data
LUMA_DATA_DIR=./data

# ─── Database (SQLite — zero-config) ───────────────────────────────────────
# file: URL relative to the project root
DATABASE_URL=file:./data/luma.db

# ─── Authentication (optional — only needed when user features are enabled) ─
# JWT_SECRET=change-me-to-at-least-32-characters-long
# SESSION_SECRET=change-me-to-at-least-32-characters-long
# CSRF_SECRET=change-me-to-at-least-32-characters-long

# ─── AI / LLM (optional — answers work without this) ────────────────────────
# Provider: openai | anthropic | ollama | disabled
LLM_PROVIDER=disabled
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1:8b

# ─── Crawler ────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT=LumaSearch/0.1 (+https://github.com/singhtanishq/LumaSearch)
CRAWLER_MAX_CONCURRENT=10
CRAWLER_PER_DOMAIN_CONCURRENT=2
CRAWLER_POLITENESS_DELAY=1000
CRAWLER_REQUEST_TIMEOUT=30000
CRAWLER_MAX_CONTENT_SIZE=10485760
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_BLOCK_PRIVATE_IPS=true

# ─── Search ─────────────────────────────────────────────────────────────────
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_RANKING_PROFILE=hybrid

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=pretty
