# ============================================================
# LumaSearch Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# For local development, docker-compose.yml provides defaults.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
WEB_PORT=3001
ADMIN_PORT=3002
WORKER_CONCURRENCY=4

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Local: postgresql://postgres:postgres@localhost:5432/lumasearch
# Production: Use connection pooling (PgBouncer) and SSL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumasearch
DATABASE_POOL_SIZE=20
DATABASE_SSL=false
DATABASE_MIGRATION_TABLE=_prisma_migrations

# ------------------------------------------------------------
# Redis (Queue, Cache, Sessions)
# ------------------------------------------------------------
# Local: redis://localhost:6379
# Production: Use TLS and AUTH
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# BullMQ Queue Configuration
QUEUE_PREFIX=lumasearch
QUEUE_DEFAULT_JOB_OPTIONS='{"attempts":3,"backoff":{"type":"exponential","delay":5000},"removeOnComplete":100,"removeOnFail":500}'

# ------------------------------------------------------------
# Elasticsearch / OpenSearch
# ------------------------------------------------------------
# Local: http://localhost:9200
# Production: Use HTTPS, auth, and consider managed service (Elastic Cloud, AWS OpenSearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CA_CERT_PATH=
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_SNIFF_INTERVAL=300000
ELASTICSEARCH_MAX_RETRIES=3

# Index Configuration
ES_INDEX_PREFIX=lumasearch
ES_NUMBER_OF_SHARDS=1
ES_NUMBER_OF_REPLICAS=0
ES_REFRESH_INTERVAL=1s

# ------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------
# Provider: "local" | "openai" | "cohere" | "voyage"
EMBEDDING_PROVIDER=local

# Local Embeddings (Python FastAPI service)
LOCAL_EMBEDDING_URL=http://localhost:8000
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
LOCAL_EMBEDDING_DIMENSIONS=768
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_MAX_LENGTH=512

# OpenAI Embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=

# Cohere Embeddings
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIMENSIONS=1024

# Voyage Embeddings
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-2
VOYAGE_EMBEDDING_DIMENSIONS=1024

# ------------------------------------------------------------
# LLM (Answer Generation)
# ------------------------------------------------------------
# Provider: "openai" | "anthropic" | "ollama" | "vertex" | "bedrock" | "disabled"
LLM_PROVIDER=disabled

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=60000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.1

# Ollama (Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vertex AI (Google Cloud)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_CHAT_MODEL=gemini-1.5-flash

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Answer Generation Configuration
ANSWER_MAX_EVIDENCE_PASSAGES=10
ANSWER_MAX_EVIDENCE_CHARS=8000
ANSWER_TOKEN_BUDGET=2000
ANSWER_CACHE_TTL=3600
ANSWER_COST_LIMIT_USD=0.10

# ------------------------------------------------------------
# Crawler
# ------------------------------------------------------------
CRAWLER_USER_AGENT=LumaSearch/0.1 (+https://lumasearch.example.com/bot)
CRAWLER_MAX_CONCURRENT_REQUESTS=10
CRAWLER_MAX_CONCURRENT_PER_DOMAIN=2
CRAWLER_REQUEST_TIMEOUT=30000
CRAWLER_MAX_RESPONSE_SIZE=10485760
CRAWLER_MAX_REDIRECTS=10
CRAWLER_POLITENESS_DELAY=1000
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_FOLLOW_NO_FOLLOW=false
CRAWLER_INDEX_NO_INDEX=false
CRAWLER_CRAWL_DELAY_MULTIPLIER=1.0

# Playwright (for JS-rendered pages)
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_MAX_CONCURRENT=4

# Crawl Safety
CRAWLER_BLOCK_PRIVATE_IPS=true
CRAWLER_ALLOWED_SCHEMES=http,https
CRAWLER_MAX_DEPTH=5
CRAWLER_URL_PARAM_LIMIT=10
CRAWLER_TRAP_PATTERNS=calendar,page/\d+,sort=,filter=,?page=\d+

# ------------------------------------------------------------
# Search & Ranking
# ------------------------------------------------------------
DEFAULT_RANKING_PROFILE=hybrid
RANKING_PROFILES=fastest,recent,primary-sources,technical,community,documentation,research,visual

# Hybrid Search Weights (RRF)
RRF_WINDOW_SIZE=100
RRF_CONSTANT=60

# Field Weights for BM25
BM25_TITLE_WEIGHT=3.0
BM25_HEADINGS_WEIGHT=2.0
BM25_CONTENT_WEIGHT=1.0
BM25_ANCHORS_WEIGHT=1.5
BM25_URL_WEIGHT=1.0

# Freshness Scoring
FRESHNESS_HALF_LIFE_DAYS=365
FRESHNESS_BOOST_MAX=2.0

# Diversity
DOMAIN_DIVERSITY_ENABLED=true
DOMAIN_DIVERSITY_FACTOR=0.3

# ------------------------------------------------------------
# Authentication & Authorization
# ------------------------------------------------------------
# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ISSUER=lumasearch
JWT_AUDIENCE=lumasearch-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# API Keys
API_KEY_PREFIX=lms_
API_KEY_HASH_ROUNDS=12

# OAuth (Optional - for SaaS mode)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Session
SESSION_SECRET=your-session-secret-change-in-production-min-32-chars
SESSION_COOKIE_NAME=lumasearch_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
FF_AI_ANSWERS_ENABLED=false
FF_CRAWLER_ENABLED=true
FF_SEMANTIC_SEARCH_ENABLED=false
FF_RESEARCH_WORKSPACE_ENABLED=true
FF_ADMIN_DASHBOARD_ENABLED=true
FF_MULTI_TENANCY_ENABLED=false
FF_PUBLIC_REGISTRATION_ENABLED=false

# ------------------------------------------------------------
# External Search Providers (Optional)
# ------------------------------------------------------------
# Brave Search API
BRAVE_API_KEY=
BRAVE_SEARCH_ENABLED=false

# Serper (Google Search API)
SERPER_API_KEY=
SERPER_ENABLED=false

# ------------------------------------------------------------
# Telemetry & Observability
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_SERVICE_NAME=lumasearch
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Prometheus
PROMETHEUS_PORT=9090
METRICS_PREFIX=lumasearch

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------
# Email (Optional - for SaaS)
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LumaSearch <noreply@lumasearch.example.com>
SMTP_TLS=true

# ------------------------------------------------------------
# Billing (Optional - for SaaS)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
BILLING_PROVIDER=stripe

# ------------------------------------------------------------
# Storage (Optional - for snapshots, exports)
# ------------------------------------------------------------
# S3 / R2 / MinIO
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
CSRF_SECRET=your-csrf-secret-change-in-production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_CRAWL_MAX=10

# ------------------------------------------------------------
# Demo / Development
# ------------------------------------------------------------
SEED_DEMO_ON_STARTUP=false
DEMO_CORPUS_URL=https://demo-data.lumasearch.example.com/corpus.json.gz