generator client {
  provider = "postgresql"
  output = "./node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core Models
// ============================================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  
  memberships Membership[] 
  sessions    Session[]
  auditLogs   AuditLog[]
  
  @@map("users")
}

model Document {
  id          String    @id @default(cuid())
  contentHash String    @unique
  title       String
  url         String
  domain      String?
  language    String?   // ISO 639-1
  contentType String?   // web, code, pdf, etc.
  publishedAt DateTime?
  crawledAt   DateTime  @default(now())
  indexedAt   DateTime?
  version     Int       @default(1)
  qualityScore Float?
  spamScore   Float?
  isDuplicate   Boolean   @default(false)
  duplicateOf   String?   // self-referencing for duplicates
  
  chunks      DocumentChunk[]
  
  @@map("documents")
}

model CodeIndex {
  id          String    @id @default(cuid())
  repo        String
  filePath    String
  symbol      String
  language    String
  license     String?
  createdAt   DateTime  @default(now())
  
  symbols      CodeIndexSymbol[]
  links        CodeIndexLink[]
  
  @@map("code_index")
}

model CodeIndexSymbol {
  id          String    @id @default(cuid())
  codeIndex   CodeIndex @relation(fields: [codeIndexId], references: [id])
  codeIndexId String
  symbol      String
  language    String
  lineNumber  Int
  columnNumber Int
  
  @@map("code_index_symbols")
}

model CodeIndexLink {
  id          String    @id @default(cuid())
  codeIndex   CodeIndex @relation(fields: [codeIndexId], references: [id])
  codeIndexId String
  sourceUrl   String
  anchorText  String
  rel         String?
  
  @@map("code_index_links")
}

model DocumentChunk {
  id          String    @id @default(cuid())
  document    Document  @relation(fields: [documentId], references: [id])
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int
  startOffset Int
  endOffset   Int
  headingPath String[]  // Hierarchy of headings
  embedding   Float[]   // Vector embedding for semantic search
  
  @@map("document_chunks")
}

model Membership {
  id        String    @id @default(cuid())
  role      String    // owner, admin, operator, analyst, readonly
  joinedAt  DateTime  @default(now())
  invitedBy String?
  
  user        User      @relation(fields: [userId], references: [id])
  userId    String
  organization String
  
  @@unique([userId])
  @@map("memberships")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  hashedKey   String
  scopes      Json
  rateLimit   Int?      
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String
  revokedAt   DateTime?
  
  @@map("api_keys")
}

model AuditLog {
  id        String    @id @default(cuid())
  action    String
  resource  String?
  resourceId String?
  metadata  Json
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  
  @@map("audit_logs")
}

model IndexSnapshot {
  id               String    @id @default(cuid())
  indexName      String
  docCount       Int
  contentHash    String
  simhash        String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  createdBy      String
  description    String?
  
  @@map("index_snapshots")
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  isPrivate   Boolean   @default(true)
  indexAlias  String
  
  @@map("collections")
}

model Alert {
  id          String    @id @default(cuid())
  name        String
  type        String    // query, topic, page, domain
  config      Json
  isActive    Boolean   @default(true)
  lastTriggeredAt DateTime?
  
  @@map("alerts")
}

model Connector {
  id          String    @id @default(cuid())
  name        String
  type        String    // github, gitlab, notion, confluence, jira, slack, gdrive, s3, rss, custom
  config      Json
  schedule    String?   // Cron expression
  status      String    // active, paused, error, never_run
  lastRunAt   DateTime?
  lastRunStatus String?   // success, partial, failed
  lastRunError String?
  
  @@map("connectors")
}

model Session {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@unique([userId, expiresAt])
  @@map("sessions")
}
