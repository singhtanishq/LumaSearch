{
  "name": "@luma-search/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@luma-search/config": "workspace:*",
    "@luma-search/crawler-core": "workspace:*",
    "@luma-search/evidence": "workspace:*",
    "@luma-search/llm": "workspace:*",
    "@luma-search/query": "workspace:*",
    "@luma-search/queue": "workspace:*",
    "@luma-search/search-engine": "workspace:*",
    "@luma-search/storage": "workspace:*",
    "@luma-search/telemetry": "workspace:*",
    "@luma-search/types": "workspace:*",
    "@luma-search/utils": "workspace:*",
    "@prisma/client": "^5.22.0",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.27.0"
  },
  "devDependencies": {
    "@luma-search/tsconfig": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
