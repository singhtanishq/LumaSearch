FROM luma-base AS worker
WORKDIR /workspace/apps/worker
# Copy Prisma client from base image
COPY --from=luma-base /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0 /workspace/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0
COPY --from=luma-base /workspace/.prisma-app /workspace/node_modules/.prisma
CMD ["pnpm", "start"]