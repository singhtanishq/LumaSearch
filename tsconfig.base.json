{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@luma-search/config": ["packages/config/src"],
      "@luma-search/types": ["packages/types/src"],
      "@luma-search/utils": ["packages/utils/src"],
      "@luma-search/search-client": ["packages/search-client/src"],
      "@luma-search/crawler-core": ["packages/crawler-core/src"],
      "@luma-search/embeddings": ["packages/embeddings/src"],
      "@luma-search/llm": ["packages/llm/src"],
      "@luma-search/ranking": ["packages/ranking/src"],
      "@luma-search/query": ["packages/query/src"],
      "@luma-search/evidence": ["packages/evidence/src"],
      "@luma-search/storage": ["packages/storage/src"],
      "@luma-search/queue": ["packages/queue/src"],
      "@luma-search/auth": ["packages/auth/src"],
      "@luma-search/telemetry": ["packages/telemetry/src"],
      "@luma-search/test-utils": ["packages/test-utils/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**", "**/*.test.ts", "**/*.spec.ts"]