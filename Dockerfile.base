# Shared base image with dependencies and packages built.
# Build from repo root: docker build -f Dockerfile.base -t luma-base .
FROM node:20-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends libssl3 && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /workspace

# Copy package files for workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/

# Copy all packages that have package.json
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/config/package.json packages/config/
COPY packages/types/package.json packages/types/
COPY packages/utils/package.json packages/utils/
COPY packages/telemetry/package.json packages/telemetry/
COPY packages/search-client/package.json packages/search-client/
COPY packages/crawler-core/package.json packages/crawler-core/
COPY packages/embeddings/package.json packages/embeddings/
COPY packages/llm/package.json packages/llm/
COPY packages/query/package.json packages/query/
COPY packages/evidence/package.json packages/evidence/
COPY packages/storage/package.json packages/storage/
COPY packages/queue/package.json packages/queue/

# Copy Prisma schema
COPY packages/storage/prisma ./packages/storage/prisma

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Generate Prisma client (no database connection needed for generation)
RUN npx prisma generate --schema=./packages/storage/prisma/schema.prisma --no-engine

# Copy sources and build packages
COPY . .
RUN pnpm --filter './packages/**' build